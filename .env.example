# noVNC Bar configuration — copy to ~/.config/novnc-bar/.env
# (plain KEY=VALUE lines; `#` starts a comment; surrounding quotes optional)

# MagicDNS hostname of the Mac running noVNC + tailscale serve.
# The app uses https://<NOVNC_HOST>/vnc.html
NOVNC_HOST=your-mac.your-tailnet.ts.net

# …or set the complete URL instead (takes priority over NOVNC_HOST):
# NOVNC_URL=https://your-mac.your-tailnet.ts.net/vnc.html
